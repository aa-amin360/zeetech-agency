{
  "name": "zeetech-web",
  "version": "1.0.0",
  "private": true,
  "description": "ZeeTech agency website — Next.js front end with a Payload CMS admin panel",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:next": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:db": "node scripts/dev-db.mjs",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "vercel-build": "cross-env NODE_ENV=production payload migrate && cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/seed.ts",
    "logos": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/add-client-logos.ts",
    "vercel:logos": "cross-env NODE_ENV=production NODE_OPTIONS=--no-deprecation payload run scripts/add-client-logos.ts",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "typecheck": "tsc --noEmit",
    "vercel:setup": "cross-env NODE_ENV=production NODE_OPTIONS=--no-deprecation payload migrate && cross-env NODE_ENV=production NODE_OPTIONS=--no-deprecation payload run scripts/seed.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/email-nodemailer": "3.90.2",
    "@payloadcms/live-preview-react": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/plugin-seo": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-vercel-blob": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@vercel/blob": "2.3.1",
    "cross-env": "^10.1.0",
    "graphql": "^16.8.1",
    "gsap": "^3.15.0",
    "next": "16.3.6",
    "payload": "3.90.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.186.0",
    "embedded-postgres": "18.4.0-beta.17",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true
  }
}
