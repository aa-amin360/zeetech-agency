# Copy to .env and fill in.

# Postgres connection. Local dev (npm run dev:db) uses the value below.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/zeetech

# Long random string — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=change-me

# Public URL of the site, no trailing slash (used for SEO, sitemap and feedback links)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Where new leads and client feedback are announced (comma-separated)
NOTIFY_EMAIL=hello@zeetech.studio

# SMTP for outgoing email (Brevo, Resend, Amazon SES, …). Leave SMTP_HOST empty
# to skip sending — everything is still saved in the admin panel.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=hello@zeetech.studio
SMTP_FROM_NAME=ZeeTech

# Vercel only: file storage for uploads (created in Vercel → Storage → Blob, which
# sets this automatically). Leave empty on the VPS — files are then kept in ./media.
BLOB_READ_WRITE_TOKEN=

# Largest video a client may upload through a feedback link, in MB
FEEDBACK_MAX_VIDEO_MB=150
